# -------------------------
# DATABASE & SERVER CONFIG
# -------------------------
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/ecomdb?schema=public                # PostgreSQL database connection URL
NODE_ENV= development                   # Environment mode (development | production)
PORT= 5000                       # Port for the backend server

# -------------------------
# JWT & AUTH TOKENS
# -------------------------
ACCESS_TOKEN_SECRET=your-long-random-secret         # Secret key for signing access tokens
REFRESH_TOKEN_SECRET=your-long-random-secret        # Secret key for signing refresh tokens

# -------------------------
# SESSION & COOKIES
# -------------------------
SESSION_SECRET=your-long-random-secret              # Secret for server-side sessions
COOKIE_DOMAIN=your-long-random-secret               # Domain where cookies will be valid
ALLOWED_ORIGINS=             # Comma-separated list of allowed frontend origins
COOKIE_SECRET=your-long-random-secret               # Secret for cookie encryption

# -------------------------
# STRIPE PAYMENT GATEWAY
# -------------------------
STRIPE_PUBLIC_KEY=your-long-random-secret           # Stripe publishable API key (frontend use)
STRIPE_SECRET_KEY=your-long-random-secret           # Stripe secret API key (backend use)
STRIPE_WEBHOOK_SECRET=your-long-random-secret       # Stripe webhook signing secret

# -------------------------
# REDIS
# -------------------------
REDIS_URL=                   # Redis connection URL for caching or sessions

# -------------------------
# GOOGLE OAUTH
# -------------------------
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID            # Google OAuth Client ID
GOOGLE_CLIENT_SECRET=your-long-random-secret        # Google OAuth Client Secret
GOOGLE_CALLBACK_URL_PROD=    # Google OAuth callback URL (production)
GOOGLE_CALLBACK_URL_DEV=http://localhost:5000/auth/google/callback     # Google OAuth callback URL (development)

# -------------------------
# FACEBOOK OAUTH
# -------------------------
FACEBOOK_APP_ID=FACEBOOK_APP_ID             # Facebook App ID
FACEBOOK_APP_SECRET=your-long-random-secret         # Facebook App Secret
FACEBOOK_CALLBACK_URL_PROD=  # Facebook OAuth callback URL (production)
FACEBOOK_CALLBACK_URL_DEV=http://localhost:5000/auth/Facebook/callback   # Facebook OAuth callback URL (development)

# -------------------------
# TWITTER OAUTH
# -------------------------
TWITTER_CONSUMER_KEY=TWITTER_CONSUMER_KEY        # Twitter API consumer key
TWITTER_CONSUMER_SECRET=TWITTER_CONSUMER_SECRET     # Twitter API consumer secret
TWITTER_CALLBACK_URL_PROD=   # Twitter OAuth callback URL (production)
TWITTER_CALLBACK_URL_DEV=http://localhost:5000/auth/Twitter/callback    # Twitter OAuth callback URL (development)

# -------------------------
# EMAIL SMTP CONFIG
# -------------------------
EMAIL_USER=                  # Email address for sending emails
EMAIL_PASS=                  # Email SMTP app password

# -------------------------
# CLOUDINARY
# -------------------------
CLOUDINARY_CLOUD_NAME=       # Cloudinary cloud name
CLOUDINARY_API_KEY=          # Cloudinary API key
CLOUDINARY_API_SECRET=       # Cloudinary API secret

# -------------------------
# CLIENT URLS
# -------------------------
CLIENT_URL_PROD=             # Frontend URL (production)
CLIENT_URL_DEV=http://localhost:3000             # Frontend URL (development)
